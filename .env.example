# API settings (src/genome2mic/api/config.py). Copy to .env for local runs; on a host,
# set these in its dashboard. Never commit .env.

# Exact frontend origins, as a JSON list. Add your Vercel production URL and any custom domain.
G2M_CORS_ORIGINS=["https://your-app.vercel.app"]
# Optional: also allow Vercel preview deploys of this project (regex, full match).
# G2M_CORS_ORIGIN_REGEX=https://your-app-[a-z0-9-]+\.vercel\.app

# Neon pooled connection string. Unset: jobs live in memory and are lost on restart.
# G2M_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# G2M_LOG_LEVEL=INFO
# G2M_TOOL_THREADS=4
