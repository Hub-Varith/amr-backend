# Run from this experiment directory; tool paths are supplied explicitly.
FLYE = config['flye']
MINIMAP = config['minimap']
PYTHON = config.get('python', 'python3')
LEVELS = ['00', '01', '02']
rule all:
    input: expand('results/{level}/metrics.json', level=LEVELS)
rule assemble:
    input: 'subsets/subset_{level}.fastq'
    output: 'results/{level}/assembly.fasta'
    log: 'results/{level}/run.log'
    threads: 4
    shell:
        '{PYTHON:q} {FLYE:q} --nano-raw {input:q} --threads {threads} --out-dir results/{wildcards.level} > {log:q} 2>&1'
rule align:
    input: asm='results/{level}/assembly.fasta', ref='reference.fasta'
    output: 'results/{level}/alignment.paf'
    log: 'results/{level}/alignment.log'
    threads: 4
    shell:
        '{MINIMAP:q} -x asm5 -c --secondary=no -t {threads} {input.ref:q} {input.asm:q} > {output:q} 2> {log:q}'
rule metrics:
    input: asm='results/{level}/assembly.fasta', ref='reference.fasta', paf='results/{level}/alignment.paf'
    output: 'results/{level}/metrics.json'
    shell:
        '{PYTHON:q} summarize.py {input.ref:q} {input.asm:q} {input.paf:q} > {output:q}'
