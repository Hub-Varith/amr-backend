# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.env

# Editors / OS
.DS_Store
.ipynb_checkpoints/

# Snakemake's per-directory metadata/lock cache.
.snakemake/

# Pipeline outputs. runs/ holds every --root used for synthetic/experimental runs;
# /models/ holds trained bundles (large, rebuilt from data). Both patterns are
# root-anchored so src/genome2mic/models/ and tests/models/ stay tracked.
/runs/
/models/

# Data and results are not committed. The one exception is the frozen split table,
# which is version-controlled by the contract (stage 7).
data/*
!data/processed/
data/processed/*
!data/processed/splits.parquet
results/

# reports/ IS committed (including reports/**/*.parquet): it holds the curated
# demo report copied out of runs/. Do not add a global *.parquet ignore.
